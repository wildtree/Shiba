<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Android版。ゲームのルール(World.cs)や絵の原画(SpriteData.cs)などは
    PC版と同じファイルをそのまま使い、描画・入力・音だけ Android 用に差し替える。
    ビルド:   dotnet build android/ShibaJintori.Android.csproj -c Release
    実機/エミュレータへ入れる: dotnet build android/ShibaJintori.Android.csproj -t:Install
    APKを作る: dotnet publish android/ShibaJintori.Android.csproj -c Release
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ShibaJintori</RootNamespace>
    <AssemblyName>ShibaJintori</AssemblyName>
    <ApplicationId>jp.wildtree.android.apps.shibajintori</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.2</ApplicationDisplayVersion>
    <Version>1.0.2</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!--
      実機 (arm64) とエミュレータ (x86_64) のどちらにも、そのまま入れられるようにしておく。
      これを書かないと Debug ビルドはそのときつないでいた機種のCPU用だけになり、
      別の機種につなぎ替えたときに「このデバイスのCPUに対応していません」で入らない。
    -->
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <!--
      高速展開 (アプリ本体とは別に .dll を送り込む仕組み) は、
      入れ直しのたびに XA0129 で失敗しやすいので使わない。
    -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!-- PC版と同じソースを使うので、こちらのフォルダだけを対象にする -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- Android側のソース -->
  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>

  <!-- PC版と共通のソース (SDLに依存しないルール・データ部分) -->
  <ItemGroup>
    <Compile Include="../World.cs" Link="Shared/World.cs" />
    <Compile Include="../Breeds.cs" Link="Shared/Breeds.cs" />
    <Compile Include="../SpriteData.cs" Link="Shared/SpriteData.cs" />
    <Compile Include="../Art.cs" Link="Shared/Art.cs" />
    <Compile Include="../Input.cs" Link="Shared/Input.cs" />
    <Compile Include="../Audio.cs" Link="Shared/Audio.cs" />
    <Compile Include="../App.cs" Link="Shared/App.cs" />
    <Compile Include="../Achievements.cs" Link="Shared/Achievements.cs" />
    <Compile Include="../HiScores.cs" Link="Shared/HiScores.cs" />
    <Compile Include="../SaveData.cs" Link="Shared/SaveData.cs" />
  </ItemGroup>

</Project>
